{
  "name": "pin-le-ge-dou",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "拼了个豆 — 像素拼了个豆闯关小游戏",
  "scripts": {
    "build:levels": "node tools/build-levels.mjs",
    "dev": "node tools/build-levels.mjs && concurrently -k -n web,api \"vite --open\" \"node --watch server/index.js\"",
    "build": "node tools/build-levels.mjs && vite build",
    "start": "npm run build && node server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "node tools/build-levels.mjs && node server/index.js",
    "art:pixelize": "node tools/pixelize.mjs",
    "art:fetch": "node tools/fetch-art.mjs",
    "art:approve": "node tools/approve-art.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
